# ---------------------------------------------------------------------------
# CodeOracle backend configuration (copy to .env and fill in)
# ---------------------------------------------------------------------------
# Never commit real keys. Only backend variables hold secrets - the frontend
# bundle must never contain a provider key (no VITE_* secrets).

# --- Database (optional; falls back to an in-memory + filesystem store) -----
MONGODB_URI=
MONGODB_DB_NAME=codeorbit

# ---------------------------------------------------------------------------
# AI service #1 - Repository chatbot
# ---------------------------------------------------------------------------
# Optimised for short conversational answers. Totally independent from test
# generation: its own provider, key, model, endpoint, timeout and retries.
# Supported providers: gemini | groq | openai_compatible
CHATBOT_PROVIDER=gemini
CHATBOT_API_KEY=
CHATBOT_MODEL=
CHATBOT_BASE_URL=
CHATBOT_TIMEOUT_SECONDS=45
CHATBOT_MAX_RETRIES=2
# Optional tuning
# CHATBOT_TEMPERATURE=0.2
# CHATBOT_MAX_TOKENS=2048
# CHATBOT_MAX_CONTEXT_ITEMS=12
# CHATBOT_MAX_CONTEXT_CHARS=24000
# CHATBOT_MAX_SOURCE_LINES=90
# CHATBOT_MAX_CITATIONS=6
# CHATBOT_MAX_HISTORY_MESSAGES=12
# CHATBOT_MAX_HISTORY_CHARS=6000
# CHATBOT_MAX_MESSAGE_CHARS=2000
# CHATBOT_RATE_LIMIT_PER_MINUTE=20
# CHATBOT_MAX_CONCURRENT=2

# ---------------------------------------------------------------------------
# AI service #2 - Test generation
# ---------------------------------------------------------------------------
# Optimised for long, correctness-critical test suites. Changing one of these
# never affects the chatbot, and the two services may use different providers.
TESTGEN_PROVIDER=groq
TESTGEN_API_KEY=
TESTGEN_MODEL=
TESTGEN_BASE_URL=
TESTGEN_TIMEOUT_SECONDS=90
TESTGEN_MAX_RETRIES=2
TESTGEN_MAX_ATTEMPTS=3
# Optional tuning
# TESTGEN_TEMPERATURE=0.1
# TESTGEN_MAX_TOKENS=4096

# ---------------------------------------------------------------------------
# Legacy / shared settings (explanations, refactoring, analysis pipeline)
# ---------------------------------------------------------------------------
# The explanation + refactoring services keep using these. A CHATBOT_*/TESTGEN_*
# key, when empty, falls back to the matching provider key here so an existing
# deployment keeps working - but each service still resolves its own provider,
# model and retry policy.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
GROQ_API_KEY=
GROQ_MODEL=llama-3.1-8b-instant
LLM_PROVIDER=groq

# Offline mode for local testing / CI (no API credits consumed)
# CODEORACLE_LLM_MOCK=true

# ---------------------------------------------------------------------------
# Hosted deployments
# ---------------------------------------------------------------------------
# Point the job store and LLM/op cache at a writable mounted volume. Leave
# unset locally (defaults to backend/cache and backend/.cache).
# CODEORACLE_DATA_DIR=/data
#
# Upload cap. Match whatever the hosting platform allows through its body
# limit (Vercel serverless would cap this near 4.5 MB - do not host this
# backend there).
# CODEORACLE_MAX_ZIP_SIZE_MB=50
